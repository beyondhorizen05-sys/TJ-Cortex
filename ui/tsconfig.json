{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "@tj-cortex/village": ["village/src/index.ts"],
      "@tj-cortex/village/*": ["village/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}